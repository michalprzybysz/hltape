# API Configuration
# REQUIRED — URL of the API (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:4000
# REQUIRED — Better Auth endpoint (must match BETTER_AUTH_URL in apps/api)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:4000/auth

# Wallet & Chain Configuration
# REQUIRED — WalletConnect project ID, get one at https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_ID=your_walletconnect_project_id
# optional (default: "true") — use Hyperliquid testnet, set to "false" for mainnet
NEXT_PUBLIC_TESTNET=true
# Builder fee is NOT configured here. It is compiled in, in
# src/lib/revenue.ts — edit that file to point it at yourself, or set the
# address to "" to remove the fee and its approval step entirely.

# Branding
# optional (default: "hltape") — name shown in page titles and user-facing copy
# NEXT_PUBLIC_BRAND_NAME=hltape

# Source Code
# optional (default: "https://github.com/michalprzybysz/hltape") — repository the footer
# links to. Read this if you deploy: AGPL-3.0 section 13 says that whoever runs this app
# for other people over a network must offer those users the source of the version they
# are actually using. If you MODIFY the code, the default below is no longer that source
# — publish your fork and point this at it. An unchanged deployment can leave it unset.
# NEXT_PUBLIC_SOURCE_URL=https://github.com/your-name/your-fork

# Instrument Icons
# optional — publishable LogoKit token used to fetch coin icons from img.logokit.com.
# Get your own at https://logokit.com. Leave unset to show a symbol-initial placeholder
# instead of calling the service.
# NEXT_PUBLIC_LOGOKIT_TOKEN=pk_your_logokit_token

# Content Security Policy
# optional — space-separated extra origins appended to the script-src and connect-src
# directives, for analytics or CDN subdomains this deployment adds on top of the
# built-in allowlist. Example:
# NEXT_PUBLIC_CSP_EXTRA_ORIGINS=https://*.example.com https://cdn.example.com

# Sentry
# optional — leave unset to disable error reporting
# NEXT_PUBLIC_SENTRY_DSN=
# optional, build time only — source map upload is skipped unless all three are set
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
