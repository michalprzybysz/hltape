{
  "name": "@furious-abacus/api",
  "version": "1.0.0",
  "private": true,
  "description": "Furious Abacus API — Fastify backend with worker threads",
  "author": "Michał Kamil Przybysz <m.przybysz@blackmoose.pl>",
  "license": "AGPL-3.0-only",
  "main": "app.ts",
  "scripts": {
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "npm run build:ts && tsc -p test/tsconfig.json && c8 node --test -r ts-node/register \"test/**/*.ts\"",
    "auth:generate": "pnpm dlx @better-auth/cli generate --output src/db/schema/auth.ts --config src/lib/auth.ts",
    "db:migrate:prod": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@fastify/auth": "^5.1.1",
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/sse": "^0.6.0",
    "@logtail/node": "^0.5.9",
    "@nktkas/hyperliquid": "^0.32.2",
    "@sentry/node": "^10.75.0",
    "better-auth": "~1.7.5",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "ethereum-blockies-base64": "^1.0.2",
    "fastify": "^5.12.5",
    "fastify-cli": "^8.0.2",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.23.0",
    "threads": "^1.7.0",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.1",
    "drizzle-kit": "^0.31.10",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  }
}
