# ---------------------------------------------------------------------------
# @furious-abacus/api - server environment
#
# Copy this file to apps/api/.env and fill it in:
#   cp apps/api/.env.example apps/api/.env
#
# Every variable below is parsed and validated once, at startup, by
# apps/api/src/lib/config.ts. If anything REQUIRED is missing or malformed the
# server refuses to boot and prints the full list of problems at once.
# ---------------------------------------------------------------------------

# REQUIRED - PostgreSQL connection string.
# Any Postgres 14+ instance works: local Docker, Neon, Supabase, RDS.
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# REQUIRED - secret used by Better Auth to sign sessions.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# REQUIRED - public base URL of the auth endpoints exposed by THIS server.
# Locally that is the API origin plus /auth.
BETTER_AUTH_URL=http://localhost:4000/auth

# REQUIRED - origin of the dashboard (apps/app) allowed to call this API.
# Used for CORS and for SIWE message verification.
APP_ORIGIN=http://localhost:3000

# REQUIRED - 64 hex characters (32 bytes). Encrypts agent wallet private keys
# at rest in the database. Losing or rotating it makes every stored agent
# wallet unreadable, so back it up.
# Generate with: openssl rand -hex 32
MASTER_KEY_HEX=

# optional - port the API listens on. Read by fastify-cli, whose own fallback is
# 3000 - which collides with the dashboard. Keep this set.
PORT=4000

# optional - "development" or "production". Default: development
# Sentry and the Logtail transport only activate in production.
NODE_ENV=development

# optional - "true" runs against Hyperliquid testnet, anything else is mainnet.
# Default: true. Keep it on testnet until you have tested your deployment.
TESTNET=true

# Revenue (builder fee + referral) is NOT configured here.
# It is compiled in, in src/lib/revenue.ts — edit that file to point the builder
# fee and referral code at yourself, or set both to "" to collect nothing.

# optional - BetterStack (Logtail) source token for shipping structured logs.
# Create a Source (Node.js) at https://betterstack.com/ and copy its token.
# Leave empty to log to stdout only.
LOGTAIL_SOURCE_TOKEN=

# optional - ingest host for the Logtail source above.
# Shown next to the token in the BetterStack source settings.
LOGTAIL_ENDPOINT=

# optional - Sentry DSN for server-side error reporting.
# Leave empty to disable Sentry.
SENTRY_DSN=

# optional - comma-separated list of workers to enable debug logs for.
# Options: brain, feeder, dispatcher, executor, janitor, api, * (all)
DEBUG_WORKERS=

# optional - set to "true" to log worker metrics to the console.
DEBUG_METRICS=false
